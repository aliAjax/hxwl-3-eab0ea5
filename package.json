    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.8",
    "get-port-please": "^3.2.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
